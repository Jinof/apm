meta:
  title "AI Photo Manager System Promise"
  domain photo_management
  version v24
  status active
  owner product
  summary "Local-first photo discovery with a startup story prompt and a compact photo-wall home, separate photo-wall and heatmap pages, a bottom Dock for heatmap, people, Agent search, and rightmost settings, right-swipe navigation, one-screen vertically chronological GitHub-style annual daily, weekly, and monthly heatmaps fused with full-screen time controls and no standalone frame, a full-original-resolution in-app viewer, user-triggered DINOv2 visual-similarity checks, on-device identity recognition, anonymous multimodal annotation, and search without modifying original files."
  source "human prompts 2026-08-10 through 2026-08-20, including local face and pet identity, anonymous VLM markers, selected-versus-full annotation, bounded-context inference, DINOv2 whole-photo similarity and explicit check scopes, separate photo-wall and one-screen vertically chronological heatmap pages with vertical side controls for annual daily, weekly, and monthly views, plus read-only full-original-resolution in-app photo viewing"

resource User kind actor:
  label "用户"
  summary "A person managing and searching a local photo library."

resource PhotoLibrary kind system:
  label "照片库"
  summary "The local APM catalog and search index."
  maps PhotoAssetFieldPromise relation constrains
  maps PhotoLocationFieldPromise relation constrains

resource Photo kind entity:
  label "照片"
  summary "Photo content discovered without changing the original file."
  maps PhotoAssetFieldPromise relation constrains

resource PhotoAnnotation kind data:
  label "照片标注"
  summary "Versioned multimodal-model output used for retrieval."
  maps PhotoAnnotationFieldPromise relation constrains

resource LocalModel kind capability:
  label "本地多模态模型"
  summary "A vision-language model running on the user's machine."
  maps TagPhotoFunctionPromise relation supports

resource CloudModel kind external:
  label "云端多模态模型"
  summary "An optional remote fallback that is disabled unless explicitly configured."

resource SearchResult kind ui:
  label "搜索结果"
  summary "Matching local photo paths with their latest annotation."
  maps SearchPhotosFunctionPromise relation supports

resource SearchAgent kind capability:
  label "相册搜索 Agent"
  summary "A minimal text-planning agent that invokes one read-only local photo-search skill."
  maps AgentSearchPhotosFunctionPromise relation supports

resource RecognitionProfile kind data:
  label "旧版名称候选"
  summary "Legacy CLI candidate labels retained for compatibility; Android identity never uses VLM name candidates."
  maps RecognitionProfileFieldPromise relation constrains

resource PersonIdentity kind data:
  label "本地人物身份"
  summary "A user-named person represented only by app-private face embeddings and never by a retained reference image."
  maps PersonIdentityFieldPromise relation constrains

resource FaceTemplate kind data:
  label "注册人脸模板"
  summary "A normalized on-device face embedding created from the one face explicitly selected by the user."
  maps FaceTemplateFieldPromise relation constrains

resource FaceObservation kind data:
  label "照片人脸观察"
  summary "One locally detected face embedding with a thresholded matched or unknown result and complete model provenance."
  maps FaceObservationFieldPromise relation constrains

resource PetIdentity kind data:
  label "本地宠物身份"
  summary "A user-named pet represented by app-private visual embeddings and never by a retained reference image."
  maps PetIdentityFieldPromise relation constrains

resource PetTemplate kind data:
  label "注册宠物模板"
  summary "A normalized on-device visual embedding created from the one detected cat or dog explicitly selected by the user."
  maps PetTemplateFieldPromise relation constrains

resource PetObservation kind data:
  label "照片宠物观察"
  summary "One locally detected cat or dog embedding with a thresholded matched or unknown result and complete model provenance."
  maps PetObservationFieldPromise relation constrains

resource PhotoVisualFeature kind data:
  label "照片视觉特征"
  summary "Versioned on-device DINOv2 ViT-S/14 registers global and 4x4 spatial embeddings for one photo."
  maps PhotoVisualFeatureFieldPromise relation constrains

resource GeneralSubjectObservation kind data:
  label "通用主体观察"
  summary "One locally detected non-person, non-pet subject crop represented by a DINOv2 embedding and auditable bounds."
  maps GeneralSubjectObservationFieldPromise relation constrains

resource SimilarPhotoResult kind ui:
  label "相似照片结果"
  summary "A read-only ranked candidate with separate burst, whole-scene, composition, and subject evidence."
  maps SimilarPhotoResultFieldPromise relation constrains
  maps FindSimilarAndroidPhotosFunctionPromise relation supports

resource AndroidPhotoWall kind ui:
  label "按日照片墙"
  summary "All currently accessible Android photos appear on a dedicated photo-wall page with real capture-day groups; the annual heatmap is a separate page backed by the same projection."
  maps AndroidPhotoWallFieldPromise relation constrains
  maps BrowseAndroidPhotoWallFunctionPromise relation supports

resource AndroidPhotoHeatmap kind ui:
  label "年度照片热力图"
  summary "A dedicated one-screen vertically chronological GitHub-style annual daily, weekly, and monthly heatmap page fused with vertical year and granularity controls, filling the available content area without a standalone card, with exact range selection and a return action to the filtered photo wall."
  maps AndroidPhotoWallFieldPromise relation constrains
  maps BrowseAndroidPhotoWallFunctionPromise relation supports

resource AndroidPhotoViewer kind ui:
  label "应用内照片查看器"
  summary "A read-only full-screen APM destination that decodes the selected URI at its complete intrinsic image resolution, supports original-pixel inspection, and provides previous or next navigation."
  maps AndroidPhotoViewerFieldPromise relation constrains
  maps ViewAndroidPhotoFunctionPromise relation supports

resource SimilarityCheckRequest kind data:
  label "相似检查请求"
  summary "One explicit user-confirmed incremental, custom recent, or full visual-similarity check scope."
  maps SimilarityCheckRequestFieldPromise relation constrains
  maps CheckAndroidVisualSimilarityFunctionPromise relation supports

resource AnnotationSelection kind data:
  label "Android 标注选择"
  summary "The current explicit set of photos granted through the system photo picker for selected-photo annotation."
  maps AndroidAnnotationSelectionFieldPromise relation constrains

resource LocalFaceModel kind capability:
  label "本地人脸模型"
  summary "Bundled on-device face detector and embedding model used without a network request."
  maps RegisterPersonIdentityFunctionPromise relation supports
  maps MatchAndroidFacesFunctionPromise relation supports

resource LocalPetModel kind capability:
  label "本地宠物模型"
  summary "Bundled on-device cat and dog detector plus visual embedding model used without a network request."
  maps RegisterPetIdentityFunctionPromise relation supports
  maps MatchAndroidPetsFunctionPromise relation supports

resource LocalVisualModel kind capability:
  label "本地 DINOv2 视觉模型"
  summary "The public Apache-2.0 DINOv2 ViT-S/14 registers image encoder executed by ONNX Runtime Android that returns a normalized global vector and spatial patch tokens without a network request."
  maps IndexAndroidVisualSimilarityFunctionPromise relation supports
  maps CheckAndroidVisualSimilarityFunctionPromise relation supports
  maps FindSimilarAndroidPhotosFunctionPromise relation supports

resource AndroidApp kind system:
  label "Android Native App"
  summary "A native Android client that reads MediaStore, stores a device-local catalog, calls an explicitly configured VLM, and searches structured annotations."
  maps AndroidMediaLocationFieldPromise relation constrains
  maps InferenceConfigurationFieldPromise relation constrains
  maps RecognitionProfileFieldPromise relation constrains
  maps PersonIdentityFieldPromise relation constrains
  maps FaceTemplateFieldPromise relation constrains
  maps FaceObservationFieldPromise relation constrains
  maps PetIdentityFieldPromise relation constrains
  maps PetTemplateFieldPromise relation constrains
  maps PetObservationFieldPromise relation constrains
  maps PhotoVisualFeatureFieldPromise relation constrains
  maps GeneralSubjectObservationFieldPromise relation constrains
  maps SimilarPhotoResultFieldPromise relation constrains
  maps AndroidPhotoWallFieldPromise relation constrains
  maps AndroidPhotoViewerFieldPromise relation constrains
  maps SimilarityCheckRequestFieldPromise relation constrains
  maps AndroidAnnotationSelectionFieldPromise relation constrains
  maps AndroidSearchStateFieldPromise relation constrains
  maps ScanAndroidGalleryFunctionPromise relation supports
  maps SelectAndroidPhotosForAnnotationFunctionPromise relation supports
  maps AnnotateAndroidPhotosFunctionPromise relation supports
  maps SearchAndroidGalleryFunctionPromise relation supports
  maps AgentSearchPhotosFunctionPromise relation supports
  maps RegisterPersonIdentityFunctionPromise relation supports
  maps MatchAndroidFacesFunctionPromise relation supports
  maps RegisterPetIdentityFunctionPromise relation supports
  maps MatchAndroidPetsFunctionPromise relation supports
  maps IndexAndroidVisualSimilarityFunctionPromise relation supports
  maps CheckAndroidVisualSimilarityFunctionPromise relation supports
  maps FindSimilarAndroidPhotosFunctionPromise relation supports
  maps BrowseAndroidPhotoWallFunctionPromise relation supports
  maps ViewAndroidPhotoFunctionPromise relation supports

term scan kind action:
  label "扫描"
  summary "Discover photo files beneath a user-selected directory."

term annotate kind action:
  label "标注"
  summary "Generate searchable structured metadata for a photo."

term search kind action:
  label "搜索"
  summary "Retrieve photos from local indexed metadata."

term use kind action:
  label "使用"
  summary "Select one model capability for annotation."

term configure kind action:
  label "配置"
  summary "Save an inference endpoint, model name, and explicit remote-transfer decision."

term register kind action:
  label "注册"
  summary "Name one explicitly selected detected person face or pet and store only its local embedding template."

term match kind action:
  label "匹配"
  summary "Compare a locally detected person or pet embedding with same-kind templates and retain unknown when confidence is insufficient."

term select kind action:
  label "选择"
  summary "Grant access to an explicit set of photos through the Android system photo picker."

term index kind action:
  label "索引"
  summary "Create versioned local visual features from permission-accessible photo thumbnails."

term compare kind action:
  label "比较"
  summary "Rank accessible photos by explicit visual, temporal, layout, and subject evidence."

term check kind action:
  label "检查"
  summary "Refresh visual features for one explicit incremental, recent, or full photo scope."

term browse kind action:
  label "浏览"
  summary "Inspect permission-accessible photos by capture day in thumbnail or detail presentation."

term view kind action:
  label "查看"
  summary "Open and inspect one accessible photo inside APM without mutating or handing off its original content."

term searchable_index kind effect:
  label "可搜索索引"
  summary "An index supports lookup by generated captions, tags, and visible text."

term matching_local_paths kind effect:
  label "匹配的本地路径"
  summary "Search returns current paths for matching photo content."

term local_first kind constraint:
  label "本地优先"
  summary "Photo bytes remain on-device unless the user explicitly enables a remote provider."
  maps TagPhotoFunctionPromise relation constrains

term originals_read_only kind constraint:
  label "原图只读"
  summary "APM must never modify or delete user photo files."
  maps ScanLibraryFunctionPromise relation constrains

term local_library kind scope:
  label "本地照片库"
  summary "Directories explicitly selected by the user on this device."

intent PhotoManagementSystemIntent priority must:
  label "AI 照片管理系统意图"
  statement "AI assists users in managing photos by creating searchable multimodal annotations, preferring locally deployed models."
  rationale "Searchable local metadata reduces manual organization work while keeping private photos on-device by default."
  status active
  root true
  source "human prompt 2026-08-10"
  maps PhotoAssetFieldPromise relation constrains
  maps PhotoLocationFieldPromise relation constrains
  maps PhotoAnnotationFieldPromise relation constrains

intent DiscoverPhotosIntent priority must:
  label "发现照片"
  statement "The user can scan an explicitly selected local directory without altering original files."
  rationale "The catalog must reflect files while ownership of originals stays with the user."
  status active
  source "MVP interpretation 2026-08-10"
  parent PhotoManagementSystemIntent relation refines
  requires DiscoverLocalPhotos actor User action scan resource Photo scope local_library effect searchable_index constraint originals_read_only priority must
  maps ScanLibraryFunctionPromise relation motivates

intent AnnotatePhotosIntent priority must:
  label "多模态标注照片"
  statement "The system creates structured captions, tags, and visible text using a multimodal model with complete provenance."
  rationale "Versioned structured output makes indexing repeatable and model upgrades auditable."
  status active
  source "human prompt and MVP interpretation 2026-08-10"
  parent PhotoManagementSystemIntent relation refines
  requires AnnotatePhoto actor User action annotate resource PhotoAnnotation scope local_library effect searchable_index constraint local_first priority must
  maps TagPhotoFunctionPromise relation motivates

intent PreferLocalModelIntent priority must:
  label "优先本地模型"
  statement "Local multimodal inference is the default; remote inference requires explicit configuration."
  rationale "Personal photos are sensitive and should not leave the device silently."
  status active
  source "human prompt 2026-08-10"
  parent PhotoManagementSystemIntent relation constrains
  prefers PreferLocalInference actor PhotoLibrary action use resource LocalModel over CloudModel scope local_library constraint local_first priority must
  maps TagPhotoFunctionPromise relation constrains

intent SearchPhotosIntent priority must:
  label "搜索照片"
  statement "The user can search generated captions, tags, and visible text and receive matching current local paths."
  rationale "Search is the user-visible outcome of multimodal annotation."
  status active
  source "human prompt 2026-08-10"
  parent PhotoManagementSystemIntent relation refines
  requires SearchLocalPhotos actor User action search resource PhotoLibrary scope local_library effect matching_local_paths priority must
  maps SearchPhotosFunctionPromise relation motivates

intent AndroidNativeAppIntent priority must:
  label "Android 原生相册管理"
  statement "The user can grant scoped photo access, scan Android MediaStore without mutating originals, generate structured VLM annotations, and search them entirely from a native Android app."
  rationale "The requested product must be usable on Android rather than only through the existing command-line MVP."
  status active
  source "human prompt 2026-08-12"
  parent PhotoManagementSystemIntent relation refines
  requires ManageAndroidGallery actor User action scan resource AndroidApp scope local_library effect searchable_index constraint originals_read_only priority must
  maps AndroidMediaLocationFieldPromise relation constrains
  maps ScanAndroidGalleryFunctionPromise relation motivates
  maps AnnotateAndroidPhotosFunctionPromise relation motivates
  maps SearchAndroidGalleryFunctionPromise relation motivates

intent BrowseAndroidPhotoWallIntent priority must:
  label "按日浏览照片墙"
  statement "The user can use the bottom Dock for heatmap, settings, people, and Agent search, open a dedicated photo-wall page or right-swipe from the photo wall into a dedicated heatmap page, browse every currently accessible photo exactly once under its real local capture day, and inspect one-screen vertically chronological GitHub-style annual heatmaps aggregated by every day, week, or month."
  rationale "Separating browsing from compact vertically chronological annual density views keeps both the photo wall and long-range day, week, and month patterns legible without requiring every photo to be annotated."
  status active
  source "human prompts 2026-08-16 and 2026-08-17"
  parent AndroidNativeAppIntent relation refines
  requires BrowsePhotoWall actor User action browse resource AndroidPhotoWall scope local_library constraint originals_read_only priority must
  maps AndroidPhotoWallFieldPromise relation constrains
  maps BrowseAndroidPhotoWallFunctionPromise relation motivates

intent ViewAndroidPhotoIntent priority must:
  label "在 APM 内查看照片"
  statement "Tapping an accessible photo in APM opens a native full-screen viewer inside APM, where the user can inspect it with aspect-preserving fit, zoom and pan it, and move to adjacent accessible photos without handing the URI to another app."
  rationale "Viewing is a core gallery action and must remain available even when no external image application is installed or desired."
  status active
  source "human prompt 2026-08-16"
  parent AndroidNativeAppIntent relation refines
  requires ViewPhoto actor User action browse resource AndroidPhotoViewer scope local_library constraint originals_read_only priority must
  maps AndroidPhotoViewerFieldPromise relation constrains
  maps ViewAndroidPhotoFunctionPromise relation motivates

intent ScopedAndroidAnnotationIntent priority must:
  label "所选或全量标注"
  statement "The user can annotate exactly the photos explicitly authorized through 选择照片, or annotate every currently authorized accessible photo without a hidden batch limit."
  rationale "A visible scope choice prevents accidental whole-library inference while still supporting deliberate full-library annotation."
  status active
  source "human prompt 2026-08-13"
  parent AndroidNativeAppIntent relation refines
  requires SelectAnnotationPhotos actor User action select resource AnnotationSelection scope local_library constraint originals_read_only priority must
  maps AndroidAnnotationSelectionFieldPromise relation constrains
  maps SelectAndroidPhotosForAnnotationFunctionPromise relation motivates
  maps AnnotateAndroidPhotosFunctionPromise relation constrains

intent StructuredPhotoFacetsIntent priority must:
  label "结构化照片标签"
  statement "Every new annotation separates daylight, sky, counted objects, visually presented people, actions, scenes, weather, general tags, and visible text."
  rationale "Typed facets make searches such as 天黑、两只狗、女人、跑步 or 海边 auditable and useful."
  status active
  source "human prompt 2026-08-12"
  parent AnnotatePhotosIntent relation refines
  maps PhotoAnnotationFieldPromise relation constrains
  maps AnnotateAndroidPhotosFunctionPromise relation motivates

intent ExplicitAndroidInferenceIntent priority must:
  label "Android 推理地址显式授权"
  statement "The Android app defaults to a loopback Ollama URL and refuses any non-loopback endpoint until the user explicitly allows sending photo bytes to it."
  rationale "A phone commonly calls a private-LAN VLM, but personal photo transfer must never be implicit."
  status active
  source "privacy interpretation 2026-08-12"
  parent PreferLocalModelIntent relation refines
  requires ConfigureInference actor User action configure resource AndroidApp scope local_library constraint local_first priority must
  maps InferenceConfigurationFieldPromise relation constrains
  maps ConfigureAndroidModelFunctionPromise relation motivates

intent Material3AndroidExperienceIntent priority must:
  label "Material 3 Android 体验"
  statement "The Android app presents a coherent Material Design 3 hierarchy, shows the story introduction at startup instead of reserving a large permanent hero block, uses a dedicated model-settings screen, places settings at the right edge of the bottom Dock, and exposes search only after searchable annotations exist."
  rationale "The primary experience should be calm, legible, state-aware, and consistent with current native Android interaction patterns."
  status active
  source "human prompt 2026-08-13"
  parent AndroidNativeAppIntent relation refines
  maps AndroidSearchStateFieldPromise relation constrains
  maps ConfigureAndroidModelFunctionPromise relation constrains
  maps SearchAndroidGalleryFunctionPromise relation constrains

intent ReselectPartialGalleryIntent priority must:
  label "部分照片可重复选择"
  statement "On Android 14 or later, every scan action while access is partial reopens the system selection flow so the user can add or change visible photos."
  rationale "Treating partial permission as sufficient without reselection traps the user in the first selected subset."
  status active
  source "human prompt 2026-08-13 and Android 14 selected photos access guidance"
  parent AndroidNativeAppIntent relation refines
  maps ScanAndroidGalleryFunctionPromise relation constrains

intent RecognizeRegisteredPetsIntent priority must:
  label "本地注册并识别宠物"
  statement "The user can choose a reference photo, tap one locally detected cat or dog, name it, and later match the same pet using only on-device visual embeddings."
  rationale "A dedicated local pet detector and conservative embedding matcher keeps pet names out of VLM identity guesses."
  status active
  source "human prompt 2026-08-13"
  parent AnnotatePhotosIntent relation refines
  maps PetIdentityFieldPromise relation constrains
  maps PetTemplateFieldPromise relation constrains
  maps PetObservationFieldPromise relation constrains
  maps RegisterPetIdentityFunctionPromise relation motivates
  maps MatchAndroidPetsFunctionPromise relation motivates
  maps AnnotateAndroidPhotosFunctionPromise relation constrains

intent RecognizeRegisteredPeopleIntent priority must:
  label "本地注册并识别同一人物"
  statement "The user can choose a reference photo, tap one detected face, name it, and later match the same person in scanned photos using only on-device face embeddings."
  rationale "A dedicated embedding matcher is more reliable and auditable than asking a VLM to guess identity from names."
  status active
  source "human prompt 2026-08-13"
  parent AndroidNativeAppIntent relation refines
  requires RegisterKnownPerson actor User action register resource PersonIdentity scope local_library constraint local_first priority must
  maps PersonIdentityFieldPromise relation constrains
  maps FaceTemplateFieldPromise relation constrains
  maps FaceObservationFieldPromise relation constrains
  maps RegisterPersonIdentityFunctionPromise relation motivates
  maps MatchAndroidFacesFunctionPromise relation motivates

intent AgentSearchIntent priority must:
  label "Agent 自主搜索"
  statement "A minimal Agent turns one natural-language request into bounded invocations of a read-only local photo-search skill and returns deduplicated accessible results."
  rationale "Tool-mediated planning supports compound requests without granting the Agent catalog or photo mutation rights."
  status active
  source "human prompt 2026-08-13"
  parent SearchPhotosIntent relation refines
  maps AgentSearchPhotosFunctionPromise relation motivates

intent DiscoverSimilarPhotosIntent priority must:
  label "查看相似照片"
  statement "The user can tap 检查相似, explicitly choose incremental new-photo checking, a custom recent hours, days, or weeks window, or a full-library check, then open one accessible photo and inspect locally ranked burst, same-scene, composition-similar, and subject-similar photos."
  rationale "Pixel-level visual relationships require local image embeddings and spatial evidence; captions and VLM tags are too lossy to decide similarity."
  status active
  source "human prompt 2026-08-15"
  parent AndroidNativeAppIntent relation refines
  requires CompareSimilarPhotos actor User action compare resource SimilarPhotoResult scope local_library constraint local_first priority must
  requires CheckSimilarPhotos actor User action check resource SimilarityCheckRequest scope local_library constraint local_first priority must
  maps SimilarityCheckRequestFieldPromise relation constrains
  maps PhotoVisualFeatureFieldPromise relation constrains
  maps GeneralSubjectObservationFieldPromise relation constrains
  maps SimilarPhotoResultFieldPromise relation constrains
  maps IndexAndroidVisualSimilarityFunctionPromise relation motivates
  maps CheckAndroidVisualSimilarityFunctionPromise relation motivates
  maps FindSimilarAndroidPhotosFunctionPromise relation motivates

type PhotoID kind id base string:
  label "照片内容标识"
  summary "A lowercase SHA-256 digest of immutable photo bytes."
  format sha256
  generated true

type FilePath kind value base path:
  label "文件路径"
  summary "An absolute normalized local filesystem path."
  format absolute
  generated false

field PhotoAssetFieldPromise for PhotoAsset:
  label "照片内容字段 Promise"
  summary "Defines content-addressed photo truth independently of file location."
  field id type PhotoID required true nullable false default null semantic "Stable identity derived from original bytes." mutable false system true readers scan,annotate,search writers scan
  field mediaType type string required true nullable false default null semantic "Detected media type or extension-derived image type." mutable false system true readers scan,annotate,search writers scan
  field byteSize type integer required true nullable false default 0 semantic "Original file size in bytes." mutable false system true readers scan,search writers scan
  field discoveredAt type datetime required true nullable false default null semantic "First catalog discovery time." mutable false system true readers scan,search writers scan
  invariant PhotoAsset.id_is_content_hash statement "PhotoAsset.id is the lowercase SHA-256 digest of the original bytes." refs PhotoAsset.id
  invariant PhotoAsset.byte_size_non_negative statement "PhotoAsset.byteSize cannot be negative." refs PhotoAsset.byteSize must "PhotoAsset.byteSize >= 0"
  forbid PhotoAsset.no_original_mutation_flag statement "Do not introduce catalog state that claims ownership or mutation rights over original files." refs PhotoAsset.id

field PhotoLocationFieldPromise for PhotoLocation:
  label "照片位置字段 Promise"
  summary "Tracks one filesystem location for content without deleting history."
  field path type FilePath required true nullable false default null semantic "Absolute normalized source path." mutable false system false readers scan,annotate,search writers scan
  field photoId type PhotoID required true nullable false default null semantic "Content-addressed photo identity." mutable true system true readers scan,annotate,search writers scan
  field rootPath type FilePath required true nullable false default null semantic "User-selected scan root containing the path." mutable true system false readers scan,search writers scan
  field present type boolean required true nullable false default true semantic "Whether the path was observed in its latest root scan." mutable true system true readers scan,annotate,search writers scan
  field modifiedNanoseconds type integer required true nullable false default 0 semantic "Filesystem modification timestamp used for scan diagnostics." mutable true system true readers scan writers scan
  field lastSeenAt type datetime required true nullable false default null semantic "Most recent scan observation time." mutable true system true readers scan,search writers scan
  invariant PhotoLocation.annotatable_path_present statement "Only present photo paths may be sent to a model." refs PhotoLocation.present when "PhotoLocation.present == true" must "PhotoLocation.path != null"
  forbid PhotoLocation.no_implicit_delete statement "A missing path is marked absent; its catalog history is not implicitly deleted." refs PhotoLocation.present,PhotoLocation.lastSeenAt

field PhotoAnnotationFieldPromise for PhotoAnnotation:
  label "照片标注字段 Promise"
  summary "Defines immutable, versioned model-generated search metadata."
  field id type integer required true nullable false default null semantic "Monotonic annotation record identifier." mutable false system true readers annotate,search writers annotate
  field photoId type PhotoID required true nullable false default null semantic "Photo content that was analyzed." mutable false system true readers annotate,search writers annotate
  field caption type text required true nullable false default "" semantic "Concise Chinese natural-language description template that may contain only validated anonymous Pn or PETn subject markers; the UI replaces markers locally at read time." mutable false system true readers search writers annotate
  field tags type json required true nullable false default "[]" semantic "Deduplicated Chinese retrieval concepts and visible proper nouns." mutable false system true readers search writers annotate
  field facets type json required true nullable false default "{}" semantic "Validated structured daylight, sky, counted objects, people presentation, actions, scenes, and weather used for retrieval." mutable false system true readers search writers annotate
  field visibleText type text required true nullable false default "" semantic "Text visibly present in the photo, empty when none is legible." mutable false system true readers search writers annotate
  field subjectMentions type json required true nullable false default "[]" semantic "Validated VLM semantic observations keyed only by anonymous markers supplied in the image overlay; contains no identity name." mutable false system true readers search writers annotate
  field recognizedSubjects type json required true nullable false default "[]" semantic "Read-time searchable person and pet names composed exclusively from accepted local observations; never accepted from VLM output." mutable true system true readers search writers match
  field modelProvider type string required true nullable false default ollama semantic "Inference runtime that received the image." mutable false system true readers annotate,search writers annotate
  field modelName type string required true nullable false default null semantic "Exact configured model identifier." mutable false system false readers annotate,search writers annotate
  field promptVersion type string required true nullable false default null semantic "Version of the annotation instruction and schema." mutable false system true readers annotate,search writers annotate
  field createdAt type datetime required true nullable false default null semantic "Annotation completion time." mutable false system true readers annotate,search writers annotate
  invariant PhotoAnnotation.provenance_complete statement "Every annotation records provider, model, prompt version, and creation time." refs PhotoAnnotation.modelProvider,PhotoAnnotation.modelName,PhotoAnnotation.promptVersion,PhotoAnnotation.createdAt must "PhotoAnnotation.modelProvider != null and PhotoAnnotation.modelName != null and PhotoAnnotation.promptVersion != null and PhotoAnnotation.createdAt != null"
  invariant PhotoAnnotation.facets_complete statement "Every v5 annotation contains daylight, sky, objects with positive counts, people presentation with positive counts, actions, scenes, weather, and validated anonymous subject mentions, using unknown or empty output instead of guessing." refs PhotoAnnotation.facets,PhotoAnnotation.subjectMentions
  invariant PhotoAnnotation.anonymous_markers_only statement "Every VLM subject mention uses an allowed Pn or PETn marker overlaid by the phone, its kind matches that marker, and no identity label is present in the request or response." refs PhotoAnnotation.caption,PhotoAnnotation.subjectMentions
  invariant PhotoAnnotation.recognized_subjects_constrained statement "Every recognized person comes from a matched local FaceObservation and every recognized pet comes from a matched local PetObservation; uncertainty produces no name." refs PhotoAnnotation.recognizedSubjects,FaceObservation.matchedIdentityId,PetObservation.matchedIdentityId
  forbid PhotoAnnotation.no_unattributed_metadata statement "Do not write generated search metadata without model provenance." refs PhotoAnnotation.modelProvider,PhotoAnnotation.modelName,PhotoAnnotation.promptVersion
  forbid PhotoAnnotation.no_overwrite_history statement "Re-annotation appends a new record and never overwrites earlier annotations." refs PhotoAnnotation.id,PhotoAnnotation.photoId

field AndroidMediaLocationFieldPromise for AndroidMediaLocation:
  label "Android MediaStore 位置字段 Promise"
  summary "Tracks one read-only Android MediaStore content URI and its current accessibility without treating lost permission as deletion."
  field uri type string required true nullable false default null semantic "Canonical content URI returned by MediaStore." mutable false system true readers scan,annotate,search writers scan
  field mediaStoreId type integer required true nullable false default null semantic "MediaStore row identifier within the external image collection." mutable false system true readers scan writers scan
  field photoId type PhotoID required true nullable false default null semantic "SHA-256 identity computed by reading, never changing, the original content stream." mutable true system true readers scan,annotate,search writers scan
  field displayName type string required true nullable false default "" semantic "Display name exposed by MediaStore." mutable true system true readers scan,search writers scan
  field dateTakenMillis type integer required false nullable true default null semantic "Best available MediaStore capture timestamp in Unix epoch milliseconds; null means capture time is unavailable and must not be inferred." mutable true system true readers scan,compare writers scan
  field accessible type boolean required true nullable false default true semantic "Whether the URI was visible and readable during the latest permission-scoped scan." mutable true system true readers scan,annotate,search writers scan
  field modifiedSeconds type integer required true nullable false default 0 semantic "MediaStore modification timestamp used to avoid rehashing unchanged bytes." mutable true system true readers scan writers scan
  field lastSeenAt type datetime required true nullable false default null semantic "Most recent permission-scoped scan observation time." mutable true system true readers scan,search writers scan
  invariant AndroidMediaLocation.content_identity statement "An accessible URI maps to the SHA-256 digest of the bytes read from ContentResolver." refs AndroidMediaLocation.uri,AndroidMediaLocation.photoId,AndroidMediaLocation.accessible
  forbid AndroidMediaLocation.no_filesystem_assumption statement "A content URI is not converted into or treated as a writable filesystem path." refs AndroidMediaLocation.uri
  forbid AndroidMediaLocation.no_delete_inference statement "accessible=false records current permission visibility only and never claims the original was deleted." refs AndroidMediaLocation.accessible,AndroidMediaLocation.lastSeenAt

field AndroidPhotoWallFieldPromise for AndroidPhotoWall:
  label "Android 按日照片墙字段 Promise"
  summary "Defines one read-only UI projection over all distinct currently accessible photos, a dedicated photo-wall page, real local capture-day groups, display mode, and independent one-screen vertically chronological GitHub-style annual heatmap page state at daily, weekly, and monthly granularity with vertical side controls."
  field photoIds type json required true nullable false default "[]" semantic "Every distinct currently accessible content photoId exactly once, independent of annotation state." mutable true system true readers browse writers browse
  field dayGroups type json required true nullable false default "[]" semantic "Descending local-date groups followed by one optional unknown-capture-time group; order inside each group is descending dateTakenMillis then stable photoId." mutable true system true readers browse writers browse
  field displayMode type string required true nullable false default thumbnails semantic "User-selected thumbnails or details presentation; it changes layout only." mutable true system false readers browse writers browse
  field displayedYear type integer required true nullable false default null semantic "Calendar year shown by the heatmap, initially the latest captured-photo year or the current year when none is dated." mutable true system false readers browse writers browse
  field heatmapGranularity type string required true nullable false default day semantic "User-selected annual aggregation unit: day, week, or month; changing it changes only heatmap aggregation and selection scope." mutable true system false readers browse writers browse
  field selectedRange type json required false nullable true default null semantic "Optional inclusive device-local capture-date range selected from one non-empty heatmap cell; it is one date for day mode, the in-year part of a Sunday-through-Saturday calendar week for week mode, or one calendar month for month mode; null shows every day group." mutable true system false readers browse writers browse
  field dailyCounts type json required true nullable false default "{}" semantic "Map from real local capture date to the count of distinct currently accessible photoIds captured that day." mutable true system true readers browse writers browse
  invariant AndroidPhotoWall.accessible_distinct statement "photoIds contains every and only distinct currently accessible AndroidMediaLocation.photoId exactly once, including unannotated photos and libraries larger than search limits." refs AndroidPhotoWall.photoIds,AndroidMediaLocation.photoId,AndroidMediaLocation.accessible
  invariant AndroidPhotoWall.real_capture_day statement "A dated photo day is derived only by converting dateTakenMillis through the device time zone; null dateTakenMillis belongs only to the unknown group and never uses modified, discovered, indexed, or annotation time as a fallback." refs AndroidPhotoWall.dayGroups,AndroidMediaLocation.dateTakenMillis
  invariant AndroidPhotoWall.mode_preserves_membership statement "Switching displayMode or heatmapGranularity across the dedicated photo-wall and heatmap pages preserves photoIds, day membership, descending order, displayedYear, and dailyCounts exactly; changing heatmap granularity clears only selectedRange, while returning from heatmap preserves the selected range for the photo wall." refs AndroidPhotoWall.displayMode,AndroidPhotoWall.heatmapGranularity,AndroidPhotoWall.photoIds,AndroidPhotoWall.dayGroups,AndroidPhotoWall.displayedYear,AndroidPhotoWall.selectedRange,AndroidPhotoWall.dailyCounts
  invariant AndroidPhotoWall.page_ownership statement "The photo-wall page shows the story introduction only at startup, keeps the home content compact, and contains a bottom Dock ordered as heatmap, people, Agent search, settings at the right edge, plus photo display controls, optional selected-range summary, a right-swipe route, and photo cards but no annual heatmap; the independent one-screen heatmap page fuses vertical year and granularity side controls with a borderless full-area grid, guide, and selected-range controls but no photo cards." refs AndroidPhotoWall.displayMode,AndroidPhotoWall.displayedYear,AndroidPhotoWall.heatmapGranularity,AndroidPhotoWall.selectedRange
  invariant AndroidPhotoWall.heatmap_exact_counts statement "For displayedYear, day mode exposes every calendar date, week mode exposes every intersecting Sunday-through-Saturday week clipped to that year, and month mode exposes all twelve calendar months; every cell count is the exact sum of distinct dailyCounts in its inclusive range and each mode independently maps zero through its annual maximum to monotonic discrete levels zero through four, reserving zero for empty cells." refs AndroidPhotoWall.displayedYear,AndroidPhotoWall.heatmapGranularity,AndroidPhotoWall.dailyCounts
  invariant AndroidPhotoWall.selected_range_exact statement "selectedRange is null or equals one non-empty cell range for the current displayedYear and heatmapGranularity, and when present the wall shows exactly the dated groups inside that inclusive range without relabeling photos." refs AndroidPhotoWall.displayedYear,AndroidPhotoWall.heatmapGranularity,AndroidPhotoWall.selectedRange,AndroidPhotoWall.dayGroups,AndroidPhotoWall.dailyCounts
  forbid AndroidPhotoWall.no_annotation_gate statement "A photo cannot disappear from the wall solely because it lacks a VLM annotation, face or pet match, visual feature, or search text." refs AndroidPhotoWall.photoIds
  forbid AndroidPhotoWall.no_original_mutation statement "Browsing either dedicated page, toggling modes or granularity, navigating years, and selecting a daily, weekly, or monthly heatmap range never writes to MediaStore or changes an original photo." refs AndroidPhotoWall.displayMode,AndroidPhotoWall.displayedYear,AndroidPhotoWall.heatmapGranularity,AndroidPhotoWall.selectedRange,AndroidMediaLocation.uri

field AndroidPhotoViewerFieldPromise for AndroidPhotoViewer:
  label "应用内照片查看器字段 Promise"
  summary "Defines the accessible ordered photo sequence, selected photo, complete original-resolution in-memory image, and ephemeral zoom state of APM's native viewer."
  field photoIds type json required true nullable false default "[]" semantic "Stable wall-order sequence of every distinct currently accessible photo available to viewer navigation." mutable true system true readers view writers view
  field selectedPhotoId type string required false nullable true default null semantic "The currently displayed accessible photo identity, initially the exact photo tapped by the user." mutable true system false readers view writers view
  field displayBitmap type json required false nullable true default null semantic "Metadata for an in-memory decode made directly from the selected original content URI at the decoder's complete orientation-correct intrinsic width and height; decoded pixels are never persisted as a new photo." mutable true system true readers view writers view
  field zoomScale type number required true nullable false default 1 semantic "Current selected-photo scale clamped from 1 through an image-specific maximum that is at least 5 and large enough to inspect one original image pixel per display pixel, reset to 1 when the selected photo changes." mutable true system false readers view writers view
  field panOffset type json required true nullable false default "{\"x\":0,\"y\":0}" semantic "Ephemeral display translation clamped to prevent the zoomed image from being panned entirely away, reset to zero when the selected photo changes." mutable true system false readers view writers view
  invariant AndroidPhotoViewer.accessible_sequence statement "photoIds contains every distinct currently accessible AndroidPhotoWall.photoIds identity once in the same stable order, and selectedPhotoId is null only while no valid accessible photo can be selected." refs AndroidPhotoViewer.photoIds,AndroidPhotoViewer.selectedPhotoId,AndroidPhotoWall.photoIds
  invariant AndroidPhotoViewer.original_decode statement "A successful displayBitmap is decoded read-only from the selected AndroidMediaLocation.uri without loadThumbnail, target-size reduction, sampling, cropping, or other resolution loss; its dimensions equal the decoder's orientation-correct intrinsic original dimensions." refs AndroidPhotoViewer.displayBitmap,AndroidPhotoViewer.selectedPhotoId,AndroidMediaLocation.uri
  invariant AndroidPhotoViewer.zoom_bounds statement "zoomScale remains between 1 and max(5, nativePixelScale), where nativePixelScale fits one decoded original pixel to one display pixel; panOffset remains bounded and selecting another photo resets both values before its bitmap is shown." refs AndroidPhotoViewer.zoomScale,AndroidPhotoViewer.panOffset,AndroidPhotoViewer.selectedPhotoId
  forbid AndroidPhotoViewer.no_external_handoff statement "Opening or navigating the viewer cannot dispatch the selected content URI through an ACTION_VIEW or other external-app handoff." refs AndroidPhotoViewer.selectedPhotoId,AndroidMediaLocation.uri
  forbid AndroidPhotoViewer.no_original_mutation statement "Viewing, decoding, zooming, panning, and navigating never update, move, rename, trash, delete, or rewrite an original photo." refs AndroidPhotoViewer.displayBitmap,AndroidMediaLocation.uri

